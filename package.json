    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "@neon/realtime-react": "^0.2.0",
    "files-sdk": "^3.2.0",
    "framer-motion": "^11.11.17",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
